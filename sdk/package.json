{
  "name": "@perihelion/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Perihelion intent-based cross-chain bridge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Perihelion-Protocol/Perihelion.git"
  },
  "homepage": "https://github.com/Perihelion-Protocol/Perihelion",
  "bugs": "https://github.com/Perihelion-Protocol/Perihelion/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "test:coverage": "c8 --all --src src --include 'src/**' --exclude 'dist/**' --exclude 'test/**' --reporter=lcov --reporter=text --report-dir=coverage node --test --import tsx test/*.test.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "js-yaml": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
