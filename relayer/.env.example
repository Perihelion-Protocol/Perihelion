# ============================================================================
# Required configuration
# ============================================================================

# EVM escrow contract that emits bridge messages (0x-prefixed 20-byte address)
PERIHELION_ESCROW_ADDRESS=

# Soroban settlement (LayerZero OApp) contract ID (C…, 56 base-32 characters)
PERIHELION_SETTLEMENT_CONTRACT=

# Stellar signing secret key (strkey format) — required for settlement delivery
SIGNER_SECRET=

# ============================================================================
# EVM chain configuration
# ============================================================================

# EVM source chain RPC endpoint (used by the watcher)
PERIHELION_EVM_RPC_URL=http://localhost:8545

# Stellar RPC / Horizon endpoint
PERIHELION_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Number of block confirmations to wait before relaying a message
PERIHELION_CONFIRMATIONS=6

# Source EVM chain's LayerZero endpoint ID (default: 30101 for Ethereum)
PERIHELION_SOURCE_EID=30101

# ============================================================================
# Stellar chain configuration
# ============================================================================

# Stellar network passphrase (identifies which network to sign for)
STELLAR_NETWORK=Test SDF Network ; September 2015

# Stellar chain's LayerZero endpoint ID (default: 40161)
PERIHELION_STELLAR_EID=40161

# ============================================================================
# Relayer operation
# ============================================================================

# Poll interval for new messages, in milliseconds
PERIHELION_POLL_INTERVAL_MS=5000

# Path to the cursor checkpoint file, persisted after every tick so a restart
# resumes from here instead of re-scanning from genesis or skipping messages
# emitted while the relayer was down.
PERIHELION_CHECKPOINT_FILE=./.perihelion-relayer-checkpoint.json

# First block to scan on a fresh start (avoids scanning from genesis)
PERIHELION_START_BLOCK=0

# ============================================================================
# Health server configuration
# ============================================================================

# HTTP port for health/readiness/metrics endpoints
PERIHELION_HEALTH_PORT=8080

# Maximum milliseconds since last successful tick before readiness fails
# (default: 3 × PERIHELION_POLL_INTERVAL_MS)
PERIHELION_READINESS_STALE_MS=15000

# Maximum block lag (head - cursor) before readiness fails
PERIHELION_MAX_LAG_BLOCKS=500

# Bind address for the /healthz, /readyz, /metrics HTTP server. Defaults to
# loopback; widen only deliberately (e.g. 0.0.0.0 in Kubernetes, where the
# probe reaches the pod IP). See docs/relayer-runbook.md §5.3.
PERIHELION_HEALTH_HOST=127.0.0.1

# If set, /metrics requires "Authorization: Bearer <token>". /healthz and
# /readyz stay open for orchestrators regardless.
PERIHELION_METRICS_TOKEN=

# ============================================================================
# Mempool status reporting
# ============================================================================

# Base URL of the Perihelion mempool API.  When set together with
# PERIHELION_MEMPOOL_STATUS_TOKEN, the relayer reports "refunded" to the
# mempool after delivering a CancelIntent message.
PERIHELION_MEMPOOL_URL=

# Shared bearer token for PATCH /intents/:hash/status.
# Must match the token configured in the mempool's own environment.
# Leave blank to disable status reporting.
PERIHELION_MEMPOOL_STATUS_TOKEN=
