# Perihelion Docker Compose environment variables
# Copy this file to .env and fill in the required values

# Escrow contract address (shared by mempool, relayer, and solver)
# Default is Anvil's first account (for local development only)
PERIHELION_ESCROW_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Solver identification (EVM address)
PERIHELION_SOLVER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Relayer signing secret (Stellar S... format, 56 chars)
# REQUIRED: Generate a valid Stellar secret key for local development
# Example: SAAAA... (must pass checksum validation)
SIGNER_SECRET=

# Solver EVM private key (for signing transactions)
# REQUIRED: Use a valid Ethereum private key for local development
PERIHELION_EVM_PRIVATE_KEY=

# Solver Soroban secret key (Stellar S... format)
# REQUIRED: Generate a valid Stellar secret key for local development
PERIHELION_SOROBAN_SECRET_KEY=
