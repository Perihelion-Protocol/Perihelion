# Mempool configuration - copy to .env and set actual values
# Port the mempool listens on
PORT=3000

# Host to bind the mempool server to (loopback by default, can be set to 0.0.0.0 for wider access)
# WARNING: Setting this to non-loopback should only be done in secure environments
# as the mempool endpoint has no write authentication.
PERIHELION_MEMPOOL_HOST=localhost

# EVM RPC endpoint for contract interaction
PERIHELION_EVM_RPC_URL=http://anvil:8545

# Soroban RPC endpoint for contract interaction
PERIHELION_SOROBAN_RPC_URL=http://stellar:8000

# Source chain ID (EVM chain ID where the escrow is deployed)
PERIHELION_SOURCE_CHAIN_ID=31337

# PerihelionEscrow contract address on the source chain
PERIHELION_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Bearer token required for PATCH /intents/:hash/status endpoint
# If not set, status updates are unauthenticated (fine for local dev/tests, unsafe to expose publicly)
# PERIHELION_MEMPOOL_STATUS_TOKEN=your-secret-token-here
