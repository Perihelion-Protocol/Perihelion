{
  "name": "@perihelion/mempool",
  "version": "0.1.0",
  "description": "Local mock mempool server for end-to-end development",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Perihelion-Protocol/Perihelion.git"
  },
  "homepage": "https://github.com/Perihelion-Protocol/Perihelion",
  "bugs": "https://github.com/Perihelion-Protocol/Perihelion/issues",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc",
    "test": "node --test --import tsx test/*.test.ts",
    "test:coverage": "c8 --all --src src --include 'src/**' --exclude 'dist/**' --exclude 'test/**' --reporter=lcov --reporter=text --report-dir=coverage node --test --import tsx test/*.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "perihelion",
    "mempool",
    "bridge"
  ],
  "dependencies": {
    "@perihelion/sdk": "*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "js-yaml": "^5.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
