{
  "name": "@perihelion/mempool",
  "version": "0.1.0",
  "description": "Local mock mempool server for end-to-end development",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Perihelion-Protocol/Perihelion.git"
  },
  "homepage": "https://github.com/Perihelion-Protocol/Perihelion",
  "bugs": "https://github.com/Perihelion-Protocol/Perihelion/issues",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc",
    "test": "node --test --import tsx test/*.test.ts",
    "test:coverage": "c8 --all --src src --include 'src/**' --exclude 'dist/**' --exclude 'test/**' --reporter=lcov --reporter=text --report-dir=coverage node --test --import tsx test/*.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "perihelion",
    "mempool",
    "bridge"
  ],
  "dependencies": {
    "@perihelion/sdk": "*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "ajv": "^8.20.0",
    "c8": "^10.1.2",
    "js-yaml": "^4.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}
