{
  "name": "@perihelion/solver",
  "version": "0.1.0",
  "description": "Reference Perihelion solver node — monitors the intent mempool and fills orders",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "perihelion-solver": "./dist/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Perihelion-Protocol/Perihelion.git"
  },
  "homepage": "https://github.com/Perihelion-Protocol/Perihelion",
  "bugs": "https://github.com/Perihelion-Protocol/Perihelion/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "test:coverage": "c8 --all --src src --include 'src/**' --exclude 'dist/**' --exclude 'test/**' --reporter=lcov --reporter=text --report-dir=coverage node --test --import tsx test/*.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@perihelion/sdk": "*",
    "@stellar/stellar-sdk": "^12.3.0",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "c8": "^10.1.2",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}
