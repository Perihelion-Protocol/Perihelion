{
  "name": "perihelion",
  "version": "0.0.1",
  "private": true,
  "description": "Intent-based cross-chain bridge protocol connecting Stellar to EVM networks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Perihelion-Protocol/Perihelion.git"
  },
  "workspaces": [
    "sdk",
    "relayer",
    "solver",
    "mempool",
    "test"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "fmt": "npm run fmt --workspaces --if-present",
    "fmt:check": "npm run fmt:check --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "lefthook": "^1.7.0",
    "typescript": "^5.4.0"
  }
}
